# Upstash Redis REST API
# Use the same Redis database as the web deployment.
# Never commit real credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared signing secret
# Must exactly match WHITEBOARD_AUTH_SECRET in the web deployment.
# Generate a strong random value of at least 32 characters.
WHITEBOARD_AUTH_SECRET=

# Railway provides PORT automatically in production.
# Optional local overrides:
# WS_PORT=4000
# HOST=0.0.0.0
