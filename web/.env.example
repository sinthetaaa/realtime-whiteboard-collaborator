# Public WebSocket endpoint
# Local: ws://localhost:4000
# Production: wss://your-railway-domain
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Upstash Redis REST API
# Obtain these from your Upstash Redis database.
# Never commit real credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared signing secret
# Use the exact same value in the web and realtime deployments.
# Generate a strong random value of at least 32 characters.
WHITEBOARD_AUTH_SECRET=
